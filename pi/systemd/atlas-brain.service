[Unit]
Description=Atlas brain (Claude Code CLI + Upstash worker)
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/opt/atlas/.env

[Service]
Type=simple
User=atlas
Group=atlas
WorkingDirectory=/opt/atlas/apps/brain
EnvironmentFile=/opt/atlas/.env
EnvironmentFile=-/etc/atlas/env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/atlas
Environment=CLAUDE_CONFIG_DIR=/home/atlas/.claude
ExecStart=/usr/local/bin/pnpm start
Restart=always
RestartSec=10
NoNewPrivileges=false
LogRateLimitIntervalSec=30
LogRateLimitBurst=200

[Install]
WantedBy=multi-user.target
