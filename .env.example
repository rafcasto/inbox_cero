NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=431212897990
NEXT_PUBLIC_FIREBASE_APP_ID=1:431212897990:web:dc5e1bcf0b992c4b7619c7
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-0SMWLMCY5G
NEXT_PUBLIC_APP_NAME=Atlas
NEXT_PUBLIC_APP_URL=https://atlas.example.com

# server-only (Vercel: mark as sensitive)
# Service account: paste the raw JSON (single line or multi-line on Vercel) OR its base64
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_B64=
UPSTASH_REDIS_REST_URL=https://striking-eagle-299525.upstash.io
# rotated token
UPSTASH_REDIS_REST_TOKEN=
# openssl rand -hex 32 (same value on the Pi)
ATLAS_MASTER_KEY=
# any random string, also entered in Meta webhook config
# LinkedIn app (Share on LinkedIn + Sign In with LinkedIn); analytics needs Community Management API approval
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ANALYTICS_ENABLED=0
# Google OAuth (Gmail connect): Web client in Google Cloud console; same values on Vercel and the Pi
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Meta app secret, for X-Hub-Signature-256 verification
WHATSAPP_APP_SECRET=

# ───────── Pi (apps/brain + n8n) ─────────
# openssl rand -hex 32
ATLAS_BRAIN_TOKEN=
ATLAS_BRAIN_PORT=8787
ATLAS_POLL_MS=5000
# overridable per user/task in Settings → AI
ATLAS_DEFAULT_MODEL=claude-sonnet-4-5
# optional: leave empty to use `claude login` subscription auth
ANTHROPIC_API_KEY=
CLAUDE_BIN=/usr/local/bin/claude
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# permanent System User token
WHATSAPP_ACCESS_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Drive: the owner's parent folder ("Open Cowork") and the Atlas uid of that owner; Drive runs on users' own OAuth, not the service account
ATLAS_DRIVE_PARENT_FOLDER_ID=
ATLAS_DRIVE_OWNER_UID=
# which of the owner's connected Google accounts owns the parent folder
ATLAS_DRIVE_OWNER_EMAIL=
# oauth (default) | service_account  — service_account needs the parent to be a Google Workspace *Shared Drive* with the SA as Content manager.
# Set the same value on Vercel so the Gmail consent screen only asks for Drive when needed.
ATLAS_DRIVE_AUTH=oauth
N8N_API_KEY=
N8N_URL=http://n8n:5678
