{
 "name": "Atlas \u00b7 Brain health",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "*/5 * * * *"
      }
     ]
    }
   },
   "name": "Every 5 min",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "url": "http://172.17.0.1:8787/health",
    "options": {
     "timeout": 5000
    }
   },
   "name": "Brain health",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    300,
    0
   ],
   "onError": "continueErrorOutput"
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "typeValidation": "strict"
     },
     "conditions": [
      {
       "id": "1",
       "leftValue": "={{ $json.ok }}",
       "rightValue": true,
       "operator": {
        "type": "boolean",
        "operation": "true"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "name": "Healthy?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    560,
    0
   ]
  },
  {
   "parameters": {},
   "name": "OK",
   "type": "n8n-nodes-base.noOp",
   "typeVersion": 1,
   "position": [
    820,
    -100
   ]
  },
  {
   "parameters": {
    "content": "## Brain down\nAdd a WhatsApp/Email node here to alert yourself. The brain is unreachable at ATLAS_BRAIN_URL.",
    "height": 120,
    "width": 320
   },
   "name": "Note",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    820,
    120
   ]
  },
  {
   "parameters": {},
   "name": "Down",
   "type": "n8n-nodes-base.noOp",
   "typeVersion": 1,
   "position": [
    820,
    100
   ]
  }
 ],
 "connections": {
  "Every 5 min": {
   "main": [
    [
     {
      "node": "Brain health",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Brain health": {
   "main": [
    [
     {
      "node": "Healthy?",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "Down",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Healthy?": {
   "main": [
    [
     {
      "node": "OK",
      "type": "main",
      "index": 0
     }
    ],
    [
     {
      "node": "Down",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1",
  "timezone": "Pacific/Auckland"
 },
 "active": false
}