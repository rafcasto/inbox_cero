{
 "name": "Atlas \u00b7 Google Drive sync",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "*/15 * * * *"
      }
     ]
    }
   },
   "name": "Drive pull schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "http://172.17.0.1:8787/jobs",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "{\"userId\": \"*\", \"type\": \"drive.pull\", \"payload\": {}, \"idempotencyKey\": \"={{ 'Drive pull:' + $now.toISO() }}\"}",
    "options": {}
   },
   "name": "Drive pull",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    300,
    0
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "ATLAS_BRAIN",
     "name": "Atlas brain bearer"
    }
   }
  },
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "7 * * * *"
      }
     ]
    }
   },
   "name": "Drive push schedule",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    160
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "http://172.17.0.1:8787/jobs",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "{\"userId\": \"*\", \"type\": \"drive.push\", \"payload\": {}, \"idempotencyKey\": \"={{ 'Drive push:' + $now.toISO() }}\"}",
    "options": {}
   },
   "name": "Drive push",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    300,
    160
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "ATLAS_BRAIN",
     "name": "Atlas brain bearer"
    }
   }
  }
 ],
 "connections": {
  "Drive pull schedule": {
   "main": [
    [
     {
      "node": "Drive pull",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Drive push schedule": {
   "main": [
    [
     {
      "node": "Drive push",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 },
 "settings": {
  "executionOrder": "v1",
  "timezone": "Pacific/Auckland"
 },
 "active": false
}